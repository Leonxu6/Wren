# 复制为 .env 并填值(.env 已 gitignored)。留空 WREN_API_KEY → 自动 fake 模式(离线可跑)。
# ⚠️ 值与注释不要写在同一行 —— 行内注释可能被 python-dotenv 吞进值(曾导致数据写到怪目录)。

# ---- 主对话模型(Step1/Step2);openai 兼容 ----
# 供应商 key(如 DeepSeek);留空 → fake 模式
WREN_API_KEY=
WREN_BASE_URL=https://api.deepseek.com
# 便宜候选(项目头号风险:它能否撑住 Wren voice)
WREN_MODEL=deepseek-v4-flash

# ---- 判官(eval 用,可换更强推理模型;留空 key 则复用 WREN_API_KEY)----
# 多轮 arc judge = Claude Opus 4.7(2026-05-20 与 Leon 定)。WREN_JUDGE_* 是可注入 seam,
# 走 Anthropic 的 OpenAI 兼容端点通常无需新 adapter —— 例:
#   WREN_JUDGE_MODEL=claude-opus-4-7
#   WREN_JUDGE_BASE_URL=https://api.anthropic.com/v1/
#   WREN_JUDGE_API_KEY=sk-ant-...
WREN_JUDGE_MODEL=deepseek-v4-pro
WREN_JUDGE_API_KEY=
WREN_JUDGE_BASE_URL=

# ---- bake-off 候选清单(JSON 数组;留空 → 默认 v4-flash + v4-pro)----
# 例:[{"name":"v4-flash","model":"deepseek-v4-flash","base_url":"https://api.deepseek.com"}]
WREN_CANDIDATES=

# ---- eval 跑法 ----
# 每条 case 跑几次看通过率(EVAL_spec §5 建议 ≥5)
WREN_EVAL_REPS=5
# V4 是推理模型,需留足(reasoning + 输出)
WREN_MAX_TOKENS=2048

# ---- Telegram(live bot 才需要)----
TELEGRAM_BOT_TOKEN=

# ---- 行为参数 ----
# 连发消息合并窗口(秒)
WREN_DEBOUNCE_S=4
# 中期记忆注入 Step1 的事件条数上限(Phase 3)
WREN_EVENTS_CAP=40
# 留空 → 默认 ./data/users(勿在本行加行内注释)
WREN_DATA_ROOT=

# ---- 强制 fake(CI/离线):=1 时无视 key ----
WREN_FAKE_MODEL=
