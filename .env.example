# 复制为 .env 并填值(.env 已 gitignored)。
# ⚠️ 值与注释不要写在同一行 —— 行内注释可能被 python-dotenv 吞进值(曾导致数据写到怪目录)。

# ---- 主对话模型(Step1/Step2);openai 兼容 ----
# 供应商 key(如 DeepSeek)。**生产 bot 必须填**(否则 wren-bot 启动会 fail,见 #21);
# 本地演示 / 离线请设 WREN_FAKE_MODEL=1(走 fake 模型,见底部)。
WREN_API_KEY=
WREN_BASE_URL=https://api.deepseek.com
# 便宜候选(项目头号风险:它能否撑住 Wren voice)
WREN_MODEL=deepseek-v4-flash

# ---- 判官(eval 用,可换更强推理模型;留空 key 则复用 WREN_API_KEY)----
# 多轮 arc judge = Claude Opus 4.7(2026-05-20 与 Leon 定)。WREN_JUDGE_* 是可注入 seam,
# 走 Anthropic 的 OpenAI 兼容端点通常无需新 adapter —— 例:
#   WREN_JUDGE_MODEL=claude-opus-4-7
#   WREN_JUDGE_BASE_URL=https://api.anthropic.com/v1/
#   WREN_JUDGE_API_KEY=sk-ant-...
WREN_JUDGE_MODEL=deepseek-v4-pro
WREN_JUDGE_API_KEY=
WREN_JUDGE_BASE_URL=

# ---- 夜结算(Phase 6;holistic 跨天裁决,默认强档 v4-pro;同 judge 可独立 key/base_url seam)----
# 便宜模型做不稳整段关系的整体裁决(§15#4)→ 默认 v4-pro;不稳可改这行升 Opus(零代码):
#   WREN_SETTLEMENT_MODEL=claude-opus-4-7  + WREN_SETTLEMENT_BASE_URL + WREN_SETTLEMENT_API_KEY
WREN_SETTLEMENT_MODEL=deepseek-v4-pro
WREN_SETTLEMENT_API_KEY=
WREN_SETTLEMENT_BASE_URL=

# ---- bake-off 候选清单(JSON 数组;留空 → 默认 v4-flash + v4-pro)----
# 例:[{"name":"v4-flash","model":"deepseek-v4-flash","base_url":"https://api.deepseek.com"}]
WREN_CANDIDATES=

# ---- eval 跑法 ----
# 每条 case 跑几次看通过率(EVAL_spec §5 建议 ≥5)
WREN_EVAL_REPS=5
# V4 是推理模型,需留足(reasoning + 输出)
WREN_MAX_TOKENS=2048

# ---- Telegram(live bot 才需要)----
TELEGRAM_BOT_TOKEN=

# ---- 行为参数 ----
# 连发消息合并窗口(秒)
WREN_DEBOUNCE_S=4
# 中期记忆注入 Step1 的事件条数上限(Phase 3)
WREN_EVENTS_CAP=40
# 留空 → 默认 ./data/users(勿在本行加行内注释)
WREN_DATA_ROOT=

# ---- 公开发布护栏(开放链接:鉴权 + 防刷 + 成本天花板)----
# 调试命令 /setlevel /tick 的 owner 白名单(逗号分隔 chat_id)。留空 = 谁都不能用(公开默认锁死)。
WREN_OWNER_CHAT_IDS=
# 每用户每分钟入站消息上限(防刷;0=不限)
WREN_RATE_LIMIT_PER_MIN=20
# 全局每日 turn 上限(成本护栏;0=不限)。开放链接建议设(如 50-200 用户 × ~30 轮 → 几千)
WREN_DAILY_TURN_CAP=0
# 达每日上限是否硬停(=1 硬停;默认仅告警、继续服务)
WREN_DAILY_CAP_HARD=

# ---- 监测库(wren-metrics;只读消费 data/,内容不出机器)----
# chat_id 哈希盐 —— 公开发布【必须设】一个随机值,否则用源码里的默认盐 → 哈希可被读源码者反推
WREN_METRICS_SALT=
# 监测库路径(留空 → data/metrics.duckdb)
WREN_METRICS_DB=

# ---- 强制 fake(CI/离线 / 本地演示 bot):=1 时无视 key,所有模型走 FakeChatModel。
# 没 WREN_API_KEY 又想跑 `uv run wren-bot` 看 onboarding 流程 → 这条必填 1(#21)。
WREN_FAKE_MODEL=
